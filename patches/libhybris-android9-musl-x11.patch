+
+X11NativeWindow::X11NativeWindow(Display* xl_display, Window xl_window)
+{
+    HYBRIS_TRACE_BEGIN("x11-platform", "create_window", "");
+    this->m_window = xl_window;
+    this->m_display = xl_display;
+    this->m_connection = XGetXCBConnection(xl_display);
+    this->m_image = 0;
+    memset(&this->m_shminfo, 0, sizeof(this->m_shminfo));
+    this->m_shminfo.shmid = -1;
+    this->m_useShm = XShmQueryExtension(xl_display) ? true : false;
+    this->m_format = HAL_PIXEL_FORMAT_RGBA_8888;
+
+    const_cast<int&>(ANativeWindow::minSwapInterval) = 0;
+    const_cast<int&>(ANativeWindow::maxSwapInterval) = 1;
+    // This is the default as per the EGL documentation
+    this->m_swap_interval = 1;
+
+    TRACE("getting X11 window information");
+
+    XWindowAttributes window_attributes;
+    memset(&window_attributes, 0, sizeof(window_attributes));
+    if (!XGetWindowAttributes(m_display, m_window, &window_attributes)) {
+        HYBRIS_ERROR("XGetWindowAttributes failed for window 0x%lx", (unsigned long)m_window);
+        window_attributes.width = 1;
+        window_attributes.height = 1;
+        window_attributes.depth = DefaultDepth(m_display, DefaultScreen(m_display));
+    }
+
+    TRACE("window x=%d y=%d width=%d height=%d depth=%d",
+        window_attributes.x,
+        window_attributes.y,
+        window_attributes.width,
+        window_attributes.height,
+        window_attributes.depth);
+
+    m_width = window_attributes.width;
+    m_height = window_attributes.height;
+    m_depth = window_attributes.depth;
+    /* Keep gralloc buffers in the X visual's layout: a 16 bpp fbdev session
+     * (RGB565) must never be asked for 32 bpp scanout, and a 24-bit visual
+     * has no alpha, so copying RGBX straight into the XImage is correct. */
+    if (m_depth <= 16)
+        m_format = HAL_PIXEL_FORMAT_RGB_565;
+    else if (m_depth == 24)
+        m_format = HAL_PIXEL_FORMAT_RGBX_8888;
+
+    const char *env = getenv("HYBRIS_X11_FORCE_WIDTH");
+    if (env != NULL)
+    {
+        m_width = atoi(env);
+        TRACE("forced width=%d", m_width);
+    }
+
+    env = getenv("HYBRIS_X11_FORCE_HEIGHT");
+    if (env != NULL)
+    {
+        m_height = atoi(env);
+        TRACE("forced height=%d", m_height);
+    }
+
+    m_defaultWidth = m_width;
+    m_defaultHeight = m_height;
+
+    env = getenv("HYBRIS_X11_DISABLE_SHM");
+    if (env != NULL)
+    {
+        m_useShm = false;
+        TRACE("won't use MIT-SHM");
+    }
+
+    XGCValues gcvalues;
+    m_gc = XCreateGC(m_display, m_window, 0, &gcvalues);
+
+    m_xcb_gc = xcb_generate_id(m_connection);
+    xcb_create_gc(m_connection, m_xcb_gc, m_window, 0, 0);
+
+    m_specialEvent = 0;
+    m_haveDRIHybris = false;
+    tryEnableDRIHybris();
+
+    m_usage=GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_SW_READ_OFTEN;
+    pthread_mutex_init(&mutex, NULL);
+    m_freeBufs = 0;
+    m_damage_rects = NULL;
+    m_damage_n_rects = 0;
+    m_lastBuffer = 0;
+    setBufferCount(3);
+    HYBRIS_TRACE_END("x11-platform", "create_window", "");
+}
+
+X11NativeWindow::~X11NativeWindow()
+{
+    destroyBuffers();
+    destroyImage();
+    if (m_specialEvent)
+        xcb_unregister_for_special_event(m_connection, m_specialEvent);
+    xcb_free_gc(m_connection, m_xcb_gc);
+    XFreeGC(m_display, m_gc);
+    pthread_mutex_destroy(&mutex);
+}
