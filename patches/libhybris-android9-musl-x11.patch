diff --git a/hybris/include/hybris/common/musl_compat.h b/hybris/include/hybris/common/musl_compat.h
new file mode 100644
index 0000000..ad36fc4
--- /dev/null
+++ b/hybris/include/hybris/common/musl_compat.h
@@ -0,0 +1,21 @@
+/*
+ * Minimal glibc-isms that libhybris relies on but musl does not provide.
+ * Included from the non-glibc code paths only (#ifndef __GLIBC__).
+ */
+#ifndef HYBRIS_COMMON_MUSL_COMPAT_H_
+#define HYBRIS_COMMON_MUSL_COMPAT_H_
+
+#include <errno.h>
+#include <unistd.h>
+
+/* Taken from glibc's unistd.h. */
+#ifndef TEMP_FAILURE_RETRY
+#define TEMP_FAILURE_RETRY(expression) \
+  (__extension__                                                              \
+    ({ long int __result;                                                     \
+       do __result = (long int) (expression);                                 \
+       while (__result == -1L && errno == EINTR);                             \
+       __result; }))
+#endif
+
+#endif /* HYBRIS_COMMON_MUSL_COMPAT_H_ */
