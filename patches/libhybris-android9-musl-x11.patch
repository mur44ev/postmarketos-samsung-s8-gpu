+/* Android 8+ blobs normally get their properties from bionic libc. Some
+ * vendor trees (Samsung Android 9) still need the libhybris property hooks;
+ * HYBRIS_FORCE_LEGACY_PROPERTIES opts in. Evaluated once, it is consulted for
+ * every symbol lookup. */
+static int use_legacy_properties(int sdk_version)
+{
+    static int forced = -1;
+
+    if (forced < 0)
+        forced = getenv("HYBRIS_FORCE_LEGACY_PROPERTIES") != NULL;
+
+    return sdk_version < 27 || forced;
+}
