+
+int X11NativeWindow::setBuffersFormat(int format) {
+    /* A 16-bit X visual can only accept RGB565 without conversion. The Mali
+     * UDD may request its preferred 32-bit format after EGL config selection;
+     * pin it to the actual X visual so scanout layout cannot be corrupted. */
+    if (m_depth <= 16)
+        format = HAL_PIXEL_FORMAT_RGB_565;
+    if ((unsigned int)format != m_format)
+    {
+        TRACE("old-format:x%x new-format:x%x", m_format, format);
+        m_format = format;
+        /* Buffers will be re-allocated when dequeued */
+    } else {
+        TRACE("format:x%x", format);
+    }
+    return NO_ERROR;
+}
+
+void X11NativeWindow::destroyBuffer(X11NativeWindowBuffer* wnb)
+{
+    TRACE("wnb:%p", wnb);
+
+    assert(wnb != NULL);
+
+    wnb->common.decRef(&wnb->common);
+    m_freeBufs--;
+}
+
+void X11NativeWindow::destroyBuffers()
+{
+    TRACE("");
+
+    while (!m_bufList.empty())
+    {
+        destroyBuffer(m_bufList.front());
+        m_bufList.pop_front();
+    }
+    queue.clear();
+    m_lastBuffer = NULL;
+    m_freeBufs = 0;
+}
+
+X11NativeWindowBuffer *X11NativeWindow::addBuffer() {
+
+    X11NativeWindowBuffer *wnb;
+
+    wnb = new ClientX11Buffer(m_width, m_height, m_format, m_usage, m_depth);
+    m_bufList.push_back(wnb);
+    ++m_freeBufs;
+
+    TRACE("wnb:%p width:%i height:%i format:x%x usage:x%x",
+        wnb, wnb->width, wnb->height, wnb->format, wnb->usage);
+
+    return wnb;
+}
+
+int X11NativeWindow::setBufferCount(int cnt) {
+    TRACE("cnt:%d", cnt);
+
+    if ((int)m_bufList.size() == cnt)
+        return NO_ERROR;
+
+    lock();
+
+    if ((int)m_bufList.size() > cnt) {
+        /* Decreasing buffer count: drop idle buffers, never one the driver
+         * still holds. */
+        std::list<X11NativeWindowBuffer*>::iterator it = m_bufList.begin();
+        while (it != m_bufList.end() && (int)m_bufList.size() > cnt)
+        {
+            if ((*it)->busy) {
+                ++it;
+                continue;
+            }
+            if (*it == m_lastBuffer)
+                m_lastBuffer = NULL;
+            destroyBuffer(*it);
+            it = m_bufList.erase(it);
+        }
+    } else {
+        /* Increasing buffer count, start from current size */
+        for (int i = m_bufList.size(); i < cnt; i++)
+            addBuffer();
+    }
+
+    unlock();
+
+    return NO_ERROR;
+}
+
+int X11NativeWindow::setBuffersDimensions(int width, int height) {
+    if (m_width != (unsigned int)width || m_height != (unsigned int)height)
+    {
+        TRACE("old-size:%ix%i new-size:%ix%i", m_width, m_height, width, height);
+        m_width = width;
+        m_height = height;
+        /* Buffers will be re-allocated when dequeued */
+    } else {
+        TRACE("size:%ix%i", width, height);
+    }
+    return NO_ERROR;
+}
+
+int X11NativeWindow::setUsage(int usage) {
+    /* Keep Samsung's requested producer usage unchanged. Adding SW_READ at
+     * allocation time makes Exynos gralloc choose a linear CPU buffer that
+     * Bifrost refuses as a render target. We request CPU read access only
+     * while presenting the completed buffer to X11. */
+    const unsigned int requested = (unsigned int)usage;
+    if (window_debug())
+        fprintf(stderr, "libhybris-x11: usage old=0x%x requested=0x%x effective=0x%x\n", m_usage, usage, requested);
+    if (requested != m_usage)
+    {
+        m_usage = requested;
+        /* Buffers will be re-allocated when dequeued. */
+    }
+    return NO_ERROR;
+}
+
+/* Create the XImage used to present gralloc buffers at the current window
+ * size. Prefers MIT-SHM and falls back to a plain XPutImage image. */
+bool X11NativeWindow::createImage()
+{
+    if (m_useShm)
+    {
+        m_image = XShmCreateImage(m_display, CopyFromParent, m_depth,
+                                  ZPixmap, 0, &m_shminfo, m_width, m_height);
+        if (m_image)
+        {
+            size_t size = (size_t)m_image->bytes_per_line * m_image->height;
+            m_shminfo.shmid = shmget(IPC_PRIVATE, size, IPC_CREAT | 0777);
+            m_shminfo.shmaddr = m_shminfo.shmid >= 0 ? (char *)shmat(m_shminfo.shmid, 0, 0) : (char *)-1;
+            m_shminfo.readOnly = False;
+
+            if (m_shminfo.shmaddr != (char *)-1 && XShmAttach(m_display, &m_shminfo))
+            {
+                /* Once the server has attached, mark the segment for removal so
+                 * it disappears with the last detach instead of outliving a
+                 * crashed client. */
+                XSync(m_display, False);
+                shmctl(m_shminfo.shmid, IPC_RMID, NULL);
+                m_image->data = m_shminfo.shmaddr;
+                TRACE("m_shminfo.shmaddr %p", m_shminfo.shmaddr);
+                return true;
+            }
+
+            HYBRIS_ERROR("MIT-SHM setup failed (%s), falling back to XPutImage", strerror(errno));
+            if (m_shminfo.shmaddr != (char *)-1)
+                shmdt(m_shminfo.shmaddr);
+            if (m_shminfo.shmid >= 0)
+                shmctl(m_shminfo.shmid, IPC_RMID, NULL);
+            m_shminfo.shmaddr = NULL;
+            m_shminfo.shmid = -1;
+            XDestroyImage(m_image);
+            m_image = NULL;
+        }
+        m_useShm = false;
+    }
+
+    m_image = XCreateImage(m_display, CopyFromParent, m_depth, ZPixmap, 0,
+                           NULL, m_width, m_height, m_depth <= 16 ? 16 : 32, 0);
+    return m_image != NULL;
+}
+
+void X11NativeWindow::destroyImage()
+{
+    if (!m_image)
+        return;
+
+    if (m_shminfo.shmaddr)
+    {
+        XShmDetach(m_display, &m_shminfo);
+        XSync(m_display, False);
+        shmdt(m_shminfo.shmaddr);
+        m_shminfo.shmaddr = NULL;
+        m_shminfo.shmid = -1;
+    }
+    /* The data pointer is either the SHM segment or a gralloc mapping; neither
+     * belongs to Xlib. */
+    m_image->data = NULL;
+    XDestroyImage(m_image);
+    m_image = NULL;
+}
+
+void X11NativeWindow::copyToX11(X11NativeWindowBuffer *wnb) {
+    int ret;
+    void *vaddr = NULL;
+
+    ret = hybris_gralloc_lock(wnb->handle, GRALLOC_USAGE_SW_READ_OFTEN, 0, 0, wnb->width, wnb->height, &vaddr);
+    TRACE("wnb:%p gralloc lock returns %i", wnb, ret);
+    TRACE("wnb:%p lock to vaddr %p", wnb, vaddr);
+    TRACE("wnb:%p width=%d stride=%d height=%d format=%d", wnb, wnb->width, wnb->stride, wnb->height, wnb->format);
+
+    if (ret != 0 || vaddr == NULL)
+    {
+        HYBRIS_ERROR("gralloc lock of buffer %p failed: %d", wnb, ret);
+        return;
+    }
+
+    /* Rebuild the image when the window was resized; the buffer may still be
+     * the old size for this frame, so every copy below is clamped. */
+    if (m_image && ((unsigned int)m_image->width != m_width || (unsigned int)m_image->height != m_height))
+        destroyImage();
+    if (!m_image && !createImage())
+    {
+        HYBRIS_ERROR("cannot create an XImage for %ux%u depth %u", m_width, m_height, m_depth);
+        hybris_gralloc_unlock(wnb->handle);
+        return;
+    }
+
+    const int src_bpp = (wnb->format == HAL_PIXEL_FORMAT_RGB_565) ? 2 : 4;
+    const size_t src_line = (size_t)wnb->stride * src_bpp;
+    const unsigned int rows = (unsigned int)wnb->height < (unsigned int)m_image->height
+                            ? (unsigned int)wnb->height : (unsigned int)m_image->height;
+    const unsigned int cols = (unsigned int)wnb->width < (unsigned int)m_image->width
+                            ? (unsigned int)wnb->width : (unsigned int)m_image->width;
+
+    if (m_useShm)
+    {
+        const size_t copy_line = src_line < (size_t)m_image->bytes_per_line
+                               ? src_line : (size_t)m_image->bytes_per_line;
+        for (unsigned int y = 0; y < rows; ++y)
+            memcpy(m_image->data + (size_t)y * m_image->bytes_per_line,
+                   (char *)vaddr + (size_t)y * src_line, copy_line);
+        hybris_gralloc_unlock(wnb->handle);
+        XShmPutImage(m_display, m_window, m_gc, m_image, 0, 0, 0, 0, cols, rows, False);
+        /* Do not recycle the single SHM image while Xorg is still reading it. */
+        XSync(m_display, False);
+    }
+    else
+    {
+        /* Present straight out of the gralloc mapping; the row pitch is the
+         * buffer stride, not the window width. */
+        m_image->data = (char *)vaddr;
+        m_image->bytes_per_line = src_line;
+        XPutImage(m_display, m_window, m_gc, m_image, 0, 0, 0, 0, cols, rows);
+        m_image->data = NULL;
+        hybris_gralloc_unlock(wnb->handle);
+    }
+}
+
+void X11NativeWindow::tryEnableDRIHybris()
+{
+    const xcb_query_extension_reply_t *extension;
+    xcb_void_cookie_t cookie;
+    xcb_generic_error_t *error;
+
+    xcb_prefetch_extension_data (m_connection, &xcb_drihybris_id);
+    xcb_prefetch_extension_data (m_connection, &xcb_present_id);
+
+    extension = xcb_get_extension_data(m_connection, &xcb_drihybris_id);
+    if (!(extension && extension->present))
+        return;
+
+    extension = xcb_get_extension_data(m_connection, &xcb_present_id);
+    if (!(extension && extension->present))
+        return;
+
+    m_specialEventId = xcb_generate_id(m_connection);
+    m_specialEvent = xcb_register_for_special_xge(m_connection,
+                            &xcb_present_id, m_specialEventId, NULL);
+
+    cookie = xcb_present_select_input_checked(m_connection,
+            m_specialEventId, m_window,
+            XCB_PRESENT_EVENT_MASK_COMPLETE_NOTIFY |
+            XCB_PRESENT_EVENT_MASK_CONFIGURE_NOTIFY);
+
+    error = xcb_request_check(m_connection, cookie);
+    if (error) {
+        free(error);
+        xcb_unregister_for_special_event(m_connection, m_specialEvent);
+        m_specialEvent = 0;
+        return;
+    }
+
+    m_haveDRIHybris = true;
+    // HYBRIS_PIXEL_FORMAT_RGBA_8888 is used in glamor for buffer import
+    m_format = HAL_PIXEL_FORMAT_RGBA_8888;
+}
+
+void X11NativeWindow::handlePresentEvent(xcb_present_generic_event_t *ge)
+{
+    switch (ge->evtype) {
+    case XCB_PRESENT_CONFIGURE_NOTIFY: {
+        xcb_present_configure_notify_event_t *ce = (xcb_present_configure_notify_event_t *) ge;
+        TRACE("XCB_PRESENT_CONFIGURE_NOTIFY: %dx%d", ce->width, ce->height);
+        resize(ce->width, ce->height);
+        break;
+    }
+    }
+}
+
+void X11NativeWindowBuffer::pixmap_from_buffer(xcb_connection_t *connection, xcb_drawable_t drawable)
+{
+    int32_t * fds;
+    fds = (int32_t *)calloc(handle->numFds, sizeof(int));
+    for (int i = 0; i < handle->numFds; i++) {
+        fds[i] = dup(handle->data[i]);
+    }
+
+    xcb_drihybris_pixmap_from_buffer_checked(connection,
+                               (pixmap = xcb_generate_id(connection)),
+                               drawable,
+                               stride * height * 4,
+                               this->width, height, stride,
+                               windowDepth, 32,
+                               handle->numInts,
+                               handle->numFds,
+                               (const uint32_t *)(handle->data + handle->numFds),
+                               (const int32_t *)fds);
+    xcb_flush(connection);
+    free(fds);
+}
+
